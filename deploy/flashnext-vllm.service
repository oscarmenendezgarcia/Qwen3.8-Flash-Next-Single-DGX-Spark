# /etc/systemd/system/flashnext-vllm.service
#
# Qwen3.8-Flash-Next-NVFP4 (vLLM, GB10, :8890). Created 2026-09-07.
#
# NOT ENABLED. This unit exists so the evaluation can be driven the same way as
# everything else on this box, but Flash-Next cannot share the GPU with the two
# models currently served (see Conflicts= below), so enabling it is a decision
# about what this machine serves, not a deployment detail.
#
# oneshot + RemainAfterExit (not Type=simple) because the process is kept alive
# by the Docker daemon, not by systemd. start.sh is idempotent (it returns early
# if the container is already running) and blocks until /health answers, so no
# ExecStartPost readiness probe is needed.

[Unit]
Description=Qwen3.8-Flash-Next-NVFP4 (vLLM, GB10, :8890)
Documentation=file:///home/oscar/flashnext-recipe/README.md
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

# The GB10 has UNIFIED memory: GPU and host page cache come out of the same
# 121.63 GiB. This model's GPU budget is MemTotal - HOST_RESERVE_GIB (26) =
# ~94.9 GiB, and its own reserve breakdown budgets "co-tenants ~7". What runs
# here today is qwen38-dflash at mem-fraction 0.56 (~68 GiB) plus nemotron at
# gpu-memory-utilization 0.20 (~24 GiB) = ~92 GiB. There is no configuration in
# which Flash-Next coexists with either. Conflicts= makes systemd stop them
# before starting this instead of trusting nobody makes a mistake.
#
# Unlike the note in qwen38-dflash.service, both peers now have units, so both
# can be named here. (That comment is stale: it predates nemotron-vllm.service.)
#
# start.sh enforces the same rule independently -- REQUIRE_IDLE_GPU=true aborts
# at its Step 3 if nvidia-smi --query-compute-apps returns any tenant -- so a
# hand-launched peer that systemd never learned about still cannot wedge the box.
Conflicts=qwen38-dflash.service nemotron-vllm.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=oscar
WorkingDirectory=/home/oscar/flashnext-recipe

# start.sh resolves the HF cache through ${HOME}. systemd sets it from User=,
# but it is spelled out so this does not depend on that.
Environment=HOME=/home/oscar

# start.sh leaves files/memwatch.sh running in the background (nohup, so it
# stays in this unit's cgroup). It is the watchdog that stops the container when
# host MemAvailable collapses -- the failure that cost the upstream host three
# servers on 2026-09-04. KillMode=process keeps systemd from reaping it along
# with the main process; ExecStop below still shuts it down deliberately,
# because stop.sh pkills it by name.
KillMode=process

# Upstream measures ~10-12 min to /health on a warm cache. The FIRST launch also
# builds the ~27 GB packed PLE table, which this has never been timed for on
# this host -- hence the hour. Tighten it once a cold boot has been measured.
TimeoutStartSec=3600

# stop.sh archives the container and watchdog logs before stopping, and waits up
# to STOP_TIMEOUT (30 s) so vLLM can unlink its POSIX shared memory: the
# container runs with --ipc host, so segments it leaves behind leak onto the
# host's /dev/shm until reboot.
TimeoutStopSec=120

ExecStart=/home/oscar/flashnext-recipe/start.sh
ExecStop=/home/oscar/flashnext-recipe/stop.sh

[Install]
WantedBy=multi-user.target
