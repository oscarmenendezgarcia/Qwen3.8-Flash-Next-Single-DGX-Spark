# sparkDash — monitoring dashboard for this DGX Spark.
#
# Install:
#   sudo cp deploy/sparkdash.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now sparkdash
#
# oneshot + RemainAfterExit because the process is kept alive by the Docker
# daemon, not by systemd. The compose file ships restart: always; this box
# overrides it to "no" in docker-compose.override.yml so there is exactly one
# owner of the lifecycle.
#
# The container runs privileged, with the host PID namespace and host
# networking. It needs all three: nvidia-smi compute-apps is invisible without
# the PID namespace, and bridge NAT cannot reach a loopback-bound LLM. It binds
# 127.0.0.1:5555 only (BIND_HOST in .env) -- non-loopback binds fail closed.

[Unit]
Description=sparkDash (DGX Spark monitoring dashboard)
Documentation=https://github.com/MiaAI-Lab/sparkDash
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=oscar
WorkingDirectory=/home/oscar/Projects/spark-dash
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
